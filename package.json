{
  "name": "ai-rag-pipeline",
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript/Bun RAG pipeline for perps and blockchain protocol docs.",
  "scripts": {
    "test": "vitest run",
    "load": "bun run src/cli/load.ts",
    "retrieve": "bun run src/cli/retrieve.ts",
    "ingest": "bun run src/cli/ingest.ts",
    "ask": "bun run src/cli/ask.ts",
    "serve": "bun run src/cli/server.ts",
    "eval": "bun run src/cli/eval.ts",
    "eval:judge": "bun run src/cli/judge-eval.ts",
    "eval:export": "bun run src/cli/ragas-dataset.ts",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:schema:ts": "bun run src/cli/db-schema.ts",
    "bootstrap": "bun run db:schema:ts && bun run ingest data/docs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "dependencies": {
    "postgres": "^3.4.9",
    "zod": "latest"
  }
}
